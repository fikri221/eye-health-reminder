    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\n\nif (!staticData.lastSent) {\n  staticData.lastSent = 0;\n}\n\nconst lastSent = staticData.lastSent;\nconsole.log(\"lasSent: \", lastSent);\n\n// Gunakan $timezone agar otomatis mengikuti Docker ENV\nconst localTime = $now.setZone(\"Asia/Jakarta\"); \n\nconst nowMillis = localTime.toMillis();\nconst hour = localTime.hour;\nconst weekday = localTime.weekday;\n\nconsole.log(\"date: \", localTime);\n\n// 1. Tentukan Status Hari & Jam Kerja\nconst isWeekDay = weekday >= 1 && weekday <= 5; // Senin - Jumat\nconst isWorkingHour = hour >= 9 && hour < 23;   // 09:00 - 17:59\n\n// 2. Tentukan Interval Dinamis (Hanya diatur jika dalam jam kerja)\nlet intervalMinutes = 20; \nif (hour >= 12 && hour < 15) {\n  intervalMinutes = 30; // Istirahat/Siang lebih lambat\n} else if (hour >= 15 && hour < 18) {\n  intervalMinutes = 5;  // Sore lebih cepat\n}\n\n// 3. Hitung Selisih (Gunakan Math.floor agar bersih)\nconst diffMinutes = Math.floor((nowMillis - staticData.lastSent) / 60000);\n\n// 4. Syarat Pengiriman\nconst shouldSend = isWeekDay && isWorkingHour && diffMinutes >= intervalMinutes;\n\n// 5. Update lastSent jika memenuhi syarat\nif (shouldSend) {\n  staticData.lastSent = nowMillis;\n}\n\nreturn [{\n  json: {\n    currentTime: localTime.toString(),\n    nowMillis,\n    lastSent,\n    hour,\n    weekday,\n    diffMinutes,\n    intervalMinutes,\n    isWorkingHour,\n    shouldSend,\n    // Informasi tambahan untuk debugging\n    nextExecutionExpected: shouldSend ? \"Now\" : `Wait ${intervalMinutes - diffMinutes} min`\n  }\n}];"
      },
